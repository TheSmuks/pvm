#!/usr/bin/env bash
# pvm-exec — Run a command with a specific Pike version on PATH
# Usage: pvm-exec <version> <command> [args...]
#
# This is called by `pvm exec` and `pvm run` to run commands in a subshell
# with the specified Pike version's bin directory prepended to PATH.

set -euo pipefail

PVM_DIR="${PVM_DIR:-$HOME/.pvm}"

if [ $# -lt 2 ]; then
	echo "pvm-exec: usage: pvm-exec <version> <command> [args...]" >&2
	exit 1
fi

VERSION="$1"
shift

VERSION_PATH="${PVM_DIR}/versions/${VERSION}"
BIN_PATH="${VERSION_PATH}/bin"

if [ ! -x "${BIN_PATH}/pike" ]; then
	echo "pvm-exec: Pike ${VERSION} is not installed" >&2
	exit 1
fi

export PATH="${BIN_PATH}:${PATH}"

# Export Pike environment variables
MODULES_PATH="${VERSION_PATH}/build/lib/modules"
if [ -d "$MODULES_PATH" ]; then
	export PIKE_MODULE_PATH="${MODULES_PATH}${PIKE_MODULE_PATH:+:${PIKE_MODULE_PATH}}"
fi

INCLUDE_PATH="${VERSION_PATH}/build/include"
if [ -d "$INCLUDE_PATH" ]; then
	export PIKE_INCLUDE_PATH="${INCLUDE_PATH}${PIKE_INCLUDE_PATH:+:${PIKE_INCLUDE_PATH}}"
fi

if [ -f "${VERSION_PATH}/master.pike" ]; then
	export PIKE_MASTER="${VERSION_PATH}/master.pike"
fi

export PVM_PIKE_HOME="${VERSION_PATH}/build"
export PVM_PIKE_VERSION="${VERSION}"

exec "$@"
